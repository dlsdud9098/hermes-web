# Hermes Agent 게이트웨이/API 서버 주소 (vite dev 프록시 대상)
VITE_HERMES_TARGET=http://localhost:8642

# Hermes API_SERVER_KEY 와 동일한 Bearer 토큰
VITE_HERMES_KEY=change-me-local-dev

# 프록시를 안 쓰고 API 에 직접 붙을 때만 설정 (절대 URL).
# 설정 시 Hermes 쪽 API_SERVER_CORS_ORIGINS 에 이 앱 주소를 추가해야 함.
# VITE_HERMES_BASE=http://localhost:8642/v1
